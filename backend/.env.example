# ==============================================================================
# TASKNOVA Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="TASKNOVA Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="super-secret-tasknova-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite+aiosqlite:///./academicflow.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI Providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_AI_MODEL="gpt-4o"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
