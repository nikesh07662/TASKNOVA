# ==============================================================================
# TASKNOVA Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Project
PROJECT_NAME="TASKNOVA Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT (Generate a secure random key for production: openssl rand -hex 32)
SECRET_KEY="super-secret-tasknova-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For local development with SQLite:
DATABASE_URL="sqlite+aiosqlite:///./academicflow.db"
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+asyncpg://academic_user:academic_password_secure@postgres:5432/academicflow"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI Providers (Optional: At least one recommended for live AI responses)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_AI_MODEL="gpt-4o"

# Google Workspace / Classroom / Drive Integration (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 / Teams / OneDrive Integration (OAuth 2.0 Credentials)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
